{
  "targets": [
    {
      "target_name": "node_pylon",
      "sources": [
        "src/addon.cc",
        "src/mock_nodemap.cc",
        "src/mock_camera.cc",
        "react-native/shared/pylon_core.cpp"
      ],
      "include_dirs": [
        "<!@(node -p \"require('node-addon-api').include\")",
        "react-native/shared"
      ],
      "dependencies": [
        "<!(node -p \"require('node-addon-api').gyp\")"
      ],
      # N-API ABI stability: no direct V8 access, no C++ exceptions escaping
      # to JS (every Pylon::/std:: exception is caught and translated, see
      # src/). NAPI_DISABLE_CPP_EXCEPTIONS only selects node-addon-api's
      # internal error style; the compiler still needs real C++ exceptions
      # and RTTI (try/catch, dynamic_cast in GenApi/pylon headers and in the
      # mock translation units), so the toolchain defaults (-fno-exceptions,
      # -fno-rtti, /GR-, no /EHsc) are lifted per OS below.
      "defines": [
        "NAPI_VERSION=8",
        "NAPI_DISABLE_CPP_EXCEPTIONS"
      ],
      # Flavor (real SDK 26.09 vs mock opt-in) comes from build-config.gypi,
      # generated by scripts/configure-build.js before node-gyp runs (plain
      # file generation: this gyp version evaluates target conditions before
      # external variables are visible, so a condition-based flavor switch
      # silently never matches). Always build via the npm scripts, which run
      # the generator first.
      "includes": [
        "build-config.gypi"
      ],
      "cflags_cc": [
        "-std=c++17"
      ],
      "msvs_settings": {
        "VCCLCompilerTool": {
          "AdditionalOptions": [ "/std:c++17" ]
        }
      },
      "xcode_settings": {
        "CLANG_CXX_LANGUAGE_STANDARD": "c++17"
      },
      "conditions": [
        [ "OS==\"linux\"", {
          "cflags!": [ "-fno-exceptions", "-fno-rtti" ],
          "cflags_cc!": [ "-fno-exceptions", "-fno-rtti" ],
          "cflags_cc": [ "-fexceptions", "-frtti" ]
        }],
        [ "OS==\"mac\"", {
          "xcode_settings": {
            "GCC_ENABLE_CPP_EXCEPTIONS": "YES",
            "GCC_ENABLE_CPP_RTTI": "YES"
          }
        }],
        [ "OS==\"win\"", {
          "msvs_settings": {
            "VCCLCompilerTool": {
              "ExceptionHandling": 1,
              "RuntimeTypeInfo": "true"
            }
          }
        }]
      ]
    }
  ]
}
