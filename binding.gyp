{
  "targets": [
    {
      "target_name": "node_pylon",
      "sources": [
        "src/addon.cc",
        "src/buffer_factory.cc",
        "src/camera_wrap.cc",
        "src/defect_pixel.cc",
        "src/device_info.cc",
        "src/discovery.cc",
        "src/error_map.cc",
        "src/feature_persistence.cc",
        "src/grab_result.cc",
        "src/image_pipeline.cc",
        "src/node_map.cc",
        "src/pylon_image.cc",
        "src/wait_wrap.cc"
      ],
      "include_dirs": [
        "<!@(node -p \"require('node-addon-api').include\")"
      ],
      "dependencies": [
        "<!(node -p \"require('node-addon-api').gyp\")"
      ],
      # N-API ABI stability: no direct V8 access, no C++ exceptions escaping
      # to JS (every Pylon::/GenApi::/std:: exception is caught and
      # translated, see src/). NAPI_DISABLE_CPP_EXCEPTIONS only selects
      # node-addon-api's internal error style; the compiler still needs real
      # C++ exceptions and RTTI (try/catch, dynamic_cast in GenApi/pylon
      # headers), so the toolchain defaults (-fno-exceptions, -fno-rtti,
      # /GR-, no /EHsc) are lifted — partly here, partly in the generated
      # build-config.gypi (make generator ignores xcode_settings).
      "defines": [
        "NAPI_VERSION=8",
        "NAPI_DISABLE_CPP_EXCEPTIONS"
      ],
      # SDK paths, libraries and link flags come from build-config.gypi,
      # generated by scripts/configure-build.js before node-gyp runs (plain
      # file generation: this gyp version evaluates target conditions before
      # external variables are visible, so a condition-based flavor switch
      # silently never matches). Always build via the npm scripts, which run
      # the generator first.
      "includes": [
        "build-config.gypi"
      ],
      "cflags_cc": [
        "-std=c++17"
      ],
      "msvs_settings": {
        "VCCLCompilerTool": {
          "AdditionalOptions": [ "/std:c++17" ]
        }
      },
      "xcode_settings": {
        "CLANG_CXX_LANGUAGE_STANDARD": "c++17"
      },
      "conditions": [
        [ "OS==\"mac\"", {
          "xcode_settings": {
            "GCC_ENABLE_CPP_EXCEPTIONS": "YES",
            "GCC_ENABLE_CPP_RTTI": "YES"
          }
        }],
        [ "OS==\"win\"", {
          "msvs_settings": {
            "VCCLCompilerTool": {
              "ExceptionHandling": 1,
              "RuntimeTypeInfo": "true"
            }
          }
        }]
      ]
    }
  ]
}
