{
  "name": "node-pylon",
  "version": "0.1.0-scaffold",
  "description": "Native Node.js bindings for the Basler pylon C++ API (GenICam, without DataProcessing in the MVP) - node-addon-api / N-API, no SWIG, no NAN.",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sdk:fetch": "bash scripts/download-pylon-sdk.sh",
    "install": "node scripts/configure-build.js && node-gyp rebuild",
    "rebuild": "node scripts/configure-build.js && node-gyp rebuild",
    "rebuild:real": "node scripts/configure-build.js && node-gyp rebuild",
    "test": "node --test --test-concurrency=1 test/pylon/*.test.js test/genicam/*.test.js",
    "test:rn": "node --test test/rn-static.test.js",
    "sample:list": "node samples/list-devices.js",
    "sample:grab": "node samples/grab.js",
    "sample:grab-options": "node samples/grab-options.js",
    "sample:nodemap": "node samples/nodemap-params.js",
    "sample:grabattrs": "node samples/grab-attributes.js"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {},
  "gypfile": true
}
