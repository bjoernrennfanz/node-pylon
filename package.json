{
  "name": "node-pylon",
  "version": "0.1.0-scaffold",
  "description": "Native Node.js bindings for Basler pylon C++ API (GenICam, ohne DataProcessing im MVP) — node-addon-api / N-API, kein SWIG, kein NAN.",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sdk:fetch": "bash scripts/download-pylon-sdk.sh",
    "install": "bash scripts/download-pylon-sdk.sh && node-gyp rebuild",
    "rebuild": "bash scripts/download-pylon-sdk.sh && node-gyp rebuild",
    "rebuild:real": "bash scripts/download-pylon-sdk.sh && node-gyp rebuild --define=node_pylon_use_mock=0",
    "rebuild:mock": "node-gyp rebuild --define=node_pylon_use_mock=1",
    "test": "node --test \"test/*.test.js\"",
    "test:rn": "node --test test/rn-static.test.js",
    "sample:list": "node samples/list-devices.js",
    "sample:grab": "node samples/grab.js",
    "sample:grab-mock": "node samples/grab-mock.js",
    "sample:grab-options": "node samples/grab-options.js",
    "sample:nodemap": "node samples/nodemap-params.js",
    "sample:grabattrs": "node samples/grab-attributes.js"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {},
  "gypfile": true
}
